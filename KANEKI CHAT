-- Display Chat Function (No Double Msg + Unique Name Colors + Purple Small Text)
local function DisplayChatMessage(sender, message, isPrivate)
	local nameColor = GetUserColor(sender)
	local prefix = isPrivate and ("[PVT] " .. sender .. ": ") or ("[" .. sender .. "]: ")
	
	-- Formatting: Name has unique color, Message is small & purple
	local formattedMsg = "<font color='" .. nameColor .. "'>" .. prefix .. "</font><font color='#C864FF' size='13'>" .. message .. "</font>"

	pcall(function()
		StarterGui:SetCore("ChatMakeSystemMessage", {
			Text = prefix .. message,
			Color = Color3.fromRGB(200, 100, 255),
			Font = Enum.Font.SourceSansMedium,
			TextSize = 14
		})
	end)

	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if channel then
				channel:DisplaySystemMessage(formattedMsg)
			end
		end
	end)

	-- Official Head Bubble Chat
	if not isPrivate then
		local targetPlayer = Players:FindFirstChild(sender)
		if targetPlayer and targetPlayer.Character then
			local head = targetPlayer.Character:FindFirstChild("Head") or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
			if head then
				pcall(function()
					ChatService:Chat(head, message)
				end)
			end
		end
	end
end

-- Join Notification with Rainbow Username
local function NotifyUserJoin(username)
	if NotifiedUsers[username] then return end
	NotifiedUsers[username] = true

	task.spawn(function()
		while task.wait(0.1) do
			if not NotifiedUsers[username] then break end
			local rainbowHex = GetRainbowHex()
			local joinMsg = "<font color='" .. rainbowHex .. "'>[+] " .. username .. " joined the Global Script Chat!</font>"

			pcall(function()
				if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
					local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
					if channel then
						channel:DisplaySystemMessage(joinMsg)
					end
				end
			end)
			break -- Ek baar rainbow color ke sath notification bhej kar loop break karega
		end
	end)
end

-- Refresh User Menu
local function RefreshUserMenu()
	for _, child in ipairs(ScrollList:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local count = 0
	for userName, _ in pairs(ActiveUsersList) do
		if userName ~= LocalPlayer.Name then
			count = count + 1
			local UserBtn = Instance.new("TextButton")
			UserBtn.Size = UDim2.new(1, -5, 0, 20)
			UserBtn.BackgroundColor3 = Color3.fromRGB(50, 20, 70)
			UserBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			UserBtn.Font = Enum.Font.GothamMedium
			UserBtn.TextSize = 10
			UserBtn.Text = "  " .. userName
			UserBtn.TextXAlignment = Enum.TextXAlignment.Left
			UserBtn.Parent = ScrollList

			local Corner = Instance.new("UICorner")
			Corner.CornerRadius = UDim.new(0, 4)
			Corner.Parent = UserBtn

			UserBtn.MouseButton1Click:Connect(function()
				SelectedPrivateUser = userName
				TargetTag.Text = "PVT: " .. userName .. " [X]"
				TargetTag.Visible = true
				UserMenu.Visible = false
			end)
		end
	end
	ScrollList.CanvasSize = UDim2.new(0, 0, 0, count * 24)
end

