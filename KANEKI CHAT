-- Send Broadcast (Local echo sirf ek baar hoga)
local function BroadcastMessage(text)
	local payload = {
		Sender = LocalPlayer.Name,
		Message = text,
		Target = SelectedPrivateUser,
		Type = "Chat"
	}

	DisplayChatMessage(LocalPlayer.Name, text, SelectedPrivateUser ~= nil)

	task.spawn(function()
		CustomRequest({
			Url = Channel_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload)
		})
	end)
end

