local function OnSubmit()
	local text = TextBox.Text
	if text == "" or #text:gsub("%s+", "") == 0 then return end

	if string.upper(text) == "PVT" then
		TextBox.Text = ""
		RefreshUserMenu() اپنا
		UserMenu.Visible = not UserMenu.Visible
		return
	end

	TextBox.Text = ""
	BroadcastMessage(text)
end

TextBox.FocusLost:Connect(function(enter) if enter then OnSubmit() end end)
SendButton.MouseButton1Click:Connect(OnSubmit)

-- Background Sync Engine (Double message prevention check added)
local ProcessedMessages = {}

task.spawn(function()
	local lastTimestamp = os.time()

	while task.wait(1) do
		pcall(function()
			local res = CustomRequest({
				Url = Channel_URL .. "/json?poll=1&since=" .. (lastTimestamp - 2),
				Method = "GET"
			})

			if res and res.Body then
				local lines = string.split(res.Body, "\n")
				for _, line in ipairs(lines) do
					if line ~= "" then
						local s1, data = pcall(function() return HttpService:JSONDecode(line) end)
						if s1 and data and data.id and not ProcessedMessages[data.id] then
							ProcessedMessages[data.id] = true

							local s2, msg = pcall(function() return HttpService:JSONDecode(data.message) end)
							if s2 and msg and msg.Sender then
								
								ActiveUsersList[msg.Sender] = tick()

								-- Join Notification Handler
								if msg.Type == "Join" then
									NotifyUserJoin(msg.Sender)
								-- Chat Message Handler
								elseif msg.Sender ~= LocalPlayer.Name then
									NotifyUserJoin(msg.Sender) -- Agar join nahi hua to join bhi dikha dega
									
									local isForMe = (msg.Target == LocalPlayer.Name)

									if msg.Target then
										if isForMe then
											DisplayChatMessage(msg.Sender, msg.Message, true)
										end
									else
										if msg.Type ~= "Join" then
											DisplayChatMessage(msg.Sender, msg.Message, false)
										end
									end
								end
							end
						end
					end
				end
				lastTimestamp = os.time()
			end
		end)
	end
end)
