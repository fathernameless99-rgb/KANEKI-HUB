-- Display Chat Function
local function DisplayChatMessage(sender, message, isPrivate)
	local prefix = isPrivate and ("[PVT] " .. sender .. ": ") or ("[" .. sender .. "]: ")
	local purpleTextFormatted = "<font color='#C864FF' size='13'>" .. message .. "</font>"
	local fullFormatted = "<font color='#FFFFFF'>" .. prefix .. "</font>" .. purpleTextFormatted

	pcall(function()
		StarterGui:SetCore("ChatMakeSystemMessage", {
			Text = prefix .. message,
			Color = Color3.fromRGB(200, 100, 255),
			Font = Enum.Font.SourceSansMedium,
			TextSize = 14
		})
	end)

	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if channel then
				channel:DisplaySystemMessage(fullFormatted)
			end
		end
	end)

	local targetPlayer = Players:FindFirstChild(sender)
	if targetPlayer and targetPlayer.Character then
		local head = targetPlayer.Character:FindFirstChild("Head") or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
		if head then
			pcall(function()
				ChatService:Chat(head, message)
			end)
		end
	end
end

-- Refresh User List
local function RefreshUserMenu()
	for _, child in ipairs(ScrollList:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local count = 0
	for userName, _ in pairs(ActiveUsersList) do
		if userName ~= LocalPlayer.Name then
			count = count + 1
			local UserBtn = Instance.new("TextButton")
			UserBtn.Size = UDim2.new(1, -5, 0, 20)
			UserBtn.BackgroundColor3 = Color3.fromRGB(50, 20, 70)
			UserBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			UserBtn.Font = Enum.Font.GothamMedium
			UserBtn.TextSize = 10
			UserBtn.Text = "  " .. userName
			UserBtn.TextXAlignment = Enum.TextXAlignment.Left
			UserBtn.Parent = ScrollList

			local Corner = Instance.new("UICorner")
			Corner.CornerRadius = UDim.new(0, 4)
			Corner.Parent = UserBtn

			UserBtn.MouseButton1Click:Connect(function()
				SelectedPrivateUser = userName
				TargetTag.Text = "PVT: " .. userName .. " [X]"
				TargetTag.Visible = true
				UserMenu.Visible = false
			end)
		end
	end
	ScrollList.CanvasSize = UDim2.new(0, 0, 0, count * 24)
end

TargetTag.MouseButton1Click:Connect(function()
	SelectedPrivateUser = nil
	TargetTag.Visible = false
end)

-- Broadcast Message (Guaranteed Local Echo + API Send)
local function BroadcastMessage(text)
	local payload = {
		Sender = LocalPlayer.Name,
		Message = text,
		Target = SelectedPrivateUser or "",
		Time = tick()
	}

	-- Hamesha apna message turant screen par dikhayega (Bina API wait kiye)
	DisplayChatMessage(LocalPlayer.Name, text, SelectedPrivateUser ~= nil)

	task.spawn(function()
		CustomRequest({
			Url = API_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload)
		})
	end)
end

local function OnSubmit()
	local text = TextBox.Text
	if text == "" or #text:gsub("%s+", "") == 0 then return end

	if string.upper(text) == "PVT" then
		TextBox.Text = ""
		RefreshUserMenu()
		UserMenu.Visible = not UserMenu.Visible
		return
	end

	TextBox.Text = ""
	BroadcastMessage(text)
end

TextBox.FocusLost:Connect(function(enter) if enter then OnSubmit() end end)
SendButton.MouseButton1Click:Connect(OnSubmit)

-- Background Listener Loop
task.spawn(function()
	while true do
		task.wait(1.5)
		pcall(function()
			local res = CustomRequest({
				Url = API_URL,
				Method = "GET"
			})

			if res and res.Body then
				local data = HttpService:JSONDecode(res.Body)
				if data and type(data) == "table" then
					for key, msgData in pairs(data) do
						if not ProcessedMessages[key] then
							ProcessedMessages[key] = true
							
							if msgData.Sender and msgData.Sender ~= LocalPlayer.Name then
								ActiveUsersList[msgData.Sender] = tick()

								local isPrivate = (msgData.Target and msgData.Target ~= "")
								local isForMe = (msgData.Target == LocalPlayer.Name)

								if isPrivate then
									if isForMe then
										DisplayChatMessage(msgData.Sender, msgData.Message, true)
									end
								else
									DisplayChatMessage(msgData.Sender, msgData.Message, false)
								end
							end
						end
					end
				end
			end
		end)
	end
end)
