-- Universal Request Function with Error Catching
local function CustomRequest(options)
	local reqFunc = (http_request or request or (syn and syn.request) or (Fluxus and Fluxus.request) or (http and http.request))
	if reqFunc then
		local success, response = pcall(function()
			return reqFunc(options)
		end)
		if success then
			return response
		else
			warn("HTTP Request Error: ", response)
		end
	end
	return nil
end

