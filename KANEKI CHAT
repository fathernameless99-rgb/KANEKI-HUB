-- Rainbow Color Generator for Usernames
local function GetRainbowHex()
	local tickVal = tick() * 2
	local r = math.floor(math.sin(tickVal) * 127 + 128)
	local g = math.floor(math.sin(tickVal + 2) * 127 + 128)
	local b = math.floor(math.sin(tickVal + 4) * 127 + 128)
	return string.format("#%02X%02X%02X", r, g, b)
end

-- Consistent Random Color for each User (Taki har bande ka naam alag color ka ho)
local function GetUserColor(name)
	local hash = 0
	for i = 1, #name do
		hash = string.byte(name, i) + (hash * 31)
	end
	local colors = {"#FF5733", "#33FF57", "#3357FF", "#F3FF33", "#FF33F3", "#33FFF0", "#FFA533", "#A533FF"}
	return colors[(math.abs(hash) % #colors) + 1]
end

